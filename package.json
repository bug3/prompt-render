{
  "name": "md-render",
  "version": "0.2.0",
  "description": "Type-safe {{variable}} templating for prompt files with fail-closed substitution",
  "author": "bug3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bug3/md-render.git"
  },
  "bugs": {
    "url": "https://github.com/bug3/md-render/issues"
  },
  "homepage": "https://github.com/bug3/md-render#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src/ tests/",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "markdown",
    "template",
    "prompt",
    "llm",
    "md-render",
    "fail-closed",
    "type-safe",
    "schema-validation",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.5.2",
    "eslint": "^9.39.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
